{
  "name": "fitlib",
  "private": true,
  "version": "2.0.0",
  "description": "Evidence-based fitness knowledge platform",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "content:build": "tsx scripts/buildContentBridge.ts",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "start:prod": "NODE_ENV=production tsx server.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run build",
    "check:launch": "npm run lint && npm run build && npm run health-check",
    "docker:build": "docker build -t fitlib:latest .",
    "docker:run": "docker run -p 3000:3000 fitlib:latest",
    "docker:compose": "docker-compose up -d",
    "docker:compose:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up",
    "health-check": "curl -f http://localhost:3000/api/health || exit 1"
  },
  "keywords": [
    "fitness",
    "exercise-science",
    "evidence-based",
    "research",
    "knowledge-graph"
  ],
  "author": "FitLib Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@stripe/stripe-js": "^9.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "algoliasearch": "^5.52.0",
    "claude": "^0.1.1",
    "clsx": "^2.1.1",
    "code": "^5.2.4",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.2",
    "stripe": "^22.1.0",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^5.3.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.17",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vercel": "^53.1.1",
    "vite": "^6.2.3"
  }
}
